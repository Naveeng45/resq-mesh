# Copy this file to .env and fill in values. .env is git-ignored.

# ---------------------------------------------------------------------------
# Map — default is standard OpenStreetMap raster tiles, which need NO API key.
# ---------------------------------------------------------------------------
# Carto's basemaps.cartocdn.com CDN now stamps unauthenticated tiles with
# "API KEY REQUIRED", so it is no longer the default. Only set CARTO_API_KEY if
# CARTO_TILE_URL contains an {apiKey} placeholder for an authenticated endpoint.
CARTO_API_KEY=

# Optional basemap override (default: https://tile.openstreetmap.org/{z}/{x}/{y}.png):
#   Carto Voyager (needs a key):  https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?api_key={apiKey}
#   Esri dark canvas (keyless):   https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
# CARTO_TILE_URL=
# CARTO_ATTRIBUTION=© OpenStreetMap contributors · positions simulated

# ---------------------------------------------------------------------------
# Sentinel escalation notifications (all optional).
#
# Leave everything blank and the Sentinel is a silent no-op — the demo works
# offline and nothing is ever sent. Set ONE of the two URLs to route escalations
# (and only escalations) to a real human channel. Slack wins if both are set.
# Preview exactly what would be sent:  python -m app.notifications
# ---------------------------------------------------------------------------

# Slack incoming webhook (https://api.slack.com/messaging/webhooks)
# RESQ_NOTIFY_SLACK_WEBHOOK_URL=

# Generic JSON webhook — POSTs a stable {source, severity, verdict, ...} body.
# RESQ_NOTIFY_WEBHOOK_URL=

# Only alert at or above this severity: review | warning | critical
# RESQ_NOTIFY_MIN_SEVERITY=review

# Render alerts and log them, but never actually send.
# RESQ_NOTIFY_DRY_RUN=false

# HTTP timeout for a delivery attempt, in seconds.
# RESQ_NOTIFY_TIMEOUT_SECONDS=5.0

# Display-only label shown in the dashboard/CLI (the URL is never exposed).
# RESQ_NOTIFY_CHANNEL_LABEL=#eoc-ops
